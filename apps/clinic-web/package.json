{
  "name": "@phongmach/clinic-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ứng dụng phòng khám (PWA): tiếp đón, hàng chờ, khám một trang, kê đơn, in, liên thông (mô phỏng).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "e2e:visit": "node e2e/visit.mjs",
    "e2e:offline": "node e2e/offline-sign.mjs",
    "e2e:conflict": "node e2e/offline-conflict.mjs"
  },
  "dependencies": {
    "@phongmach/catalogs": "workspace:*",
    "@phongmach/clinical": "workspace:*",
    "@phongmach/fhir-vn-model": "workspace:*",
    "@phongmach/print": "workspace:*",
    "@phongmach/rules": "workspace:*",
    "dexie": "^4.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.50.0",
    "typescript": "^6.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.0"
  }
}
